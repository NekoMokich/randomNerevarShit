# =============================================================================
#  Nerevar Hub — systemd unit
# =============================================================================
#
#  УСТАНОВКА (на сервере, от root):
#
#    1. Скопируй папку nerevar-hub в /opt/nerevar-hub:
#         mkdir -p /opt/nerevar-hub
#         cp index.html server.py /opt/nerevar-hub/
#
#    2. Положи этот файл в /etc/systemd/system/:
#         cp nerevar-hub.service /etc/systemd/system/
#
#    3. Включи автозапуск:
#         systemctl daemon-reload
#         systemctl enable --now nerevar-hub
#
#    4. Проверка:
#         systemctl status nerevar-hub
#         curl http://localhost/api/stats
#
#  ЕСЛИ ПАПКА ЛЕЖИТ В ДРУГОМ МЕСТЕ — поменяй пути в WorkingDirectory
#  и в ExecStart ниже.
#
#  ДОСТУП: http://<ip-сервера>/  (порт 80)
#
#  ЛОГИ:   journalctl -u nerevar-hub -f
#          в каждой строке свой префикс [server.py pid=N] — видно, какому
#          процессу она принадлежит
#  СТОП:   systemctl stop nerevar-hub   (или kill N из лога)
#
# =============================================================================

[Unit]
Description=Nerevar Hub - web dashboard + system metrics
Documentation=file:///opt/nerevar-hub/index.html
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
WorkingDirectory=/opt/nerevar-hub
ExecStart=/usr/bin/python3 /opt/nerevar-hub/server.py --port 80

# --- Перезапуск при падении -------------------------------------------------
Restart=on-failure
RestartSec=3

# --- Базовая изоляция (не мешает работе) ------------------------------------
# python3 у Debian/Ubuntu живёт в /usr/bin/python3.
# Если у тебя иначе — поставь `which python3` и поправь ExecStart.
NoNewPrivileges=true
PrivateTmp=true

# --- Порт 80 ---------------------------------------------------------------
# Сервис запускается от root, иначе нельзя занять порт 80.
#
# Если НЕ хочешь root — закомментируй строки ниже и раскомментируй блок
# "БЕЗ ROOT". Порт 80 тогда поднимется за счёт capabilities.
#
# [Install]
# ...
# (см. блок «БЕЗ ROOT» внизу файла)

[Install]
WantedBy=multi-user.target


# =============================================================================
#  БЕЗ ROOT (опционально)
# =============================================================================
#  Закомментируй строку ExecStart и две строки изоляции выше, затем замени
#  содержимое файла на это (и убери [Install] сверху, чтобы не дублировался):
#
#  [Unit]
#  Description=Nerevar Hub - web dashboard + system metrics
#  After=network-online.target
#  Wants=network-online.target
#
#  [Service]
#  Type=simple
#  User=nobody
#  Group=nogroup
#  WorkingDirectory=/opt/nerevar-hub
#  # Порт 80 без root даём через capability:
#  ExecStart=/usr/bin/python3 /opt/nerevar-hub/server.py --port 80
#  AmbientCapabilities=CAP_NET_BIND_SERVICE
#  CapabilityBoundingSet=CAP_NET_BIND_SERVICE
#  NoNewPrivileges=true
#  PrivateTmp=true
#  Restart=on-failure
#  RestartSec=3
#
#  [Install]
#  WantedBy=multi-user.target
#
#  ВАЖНО: при User=nobody папка /opt/nerevar-hub должна быть читаема:
#    chmod -R a+rX /opt/nerevar-hub
#
# =============================================================================
