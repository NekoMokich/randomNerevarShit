# создаётся server.py в момент запуска
server.pid

# сохранённая раскладка окон панели (POST /api/layout) — личные данные
layout.json
layout.json.tmp

# банк игрока в блэкджеке (POST /api/balance) — тоже личные данные
balance.json
balance.json.tmp

# свои треки и скины в репозиторий не кладём: это чужие файлы и личный
# контент. Лежат локально, в git идут только README.md этих папок.
music/*
!music/README.md
skins/*
!skins/README.md
pics/*
!pics/README.md
# ascii-арт — штатное содержимое панели, он должен быть в репозитории,
# иначе после клонирования Picture Viewer покажет «Cannot open»
!pics/ASCII_ART.TXT

# служебные файлы ОС
.DS_Store
Thumbs.db

# служебные Python
__pycache__/
*.pyc
